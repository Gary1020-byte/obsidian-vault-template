  "macros": {
    "capture": {
      "type": "macro",
      "name": "New Capture",
      "macro": {
        "actions": [
          {
            "type": "createNote",
            "name": "Create capture",
            "path": "raw/captures",
            "template": "templates/capture.md",
            "openInNewPane": true,
            "fileName": {
              "type": "date",
              "format": "YYYY-MM-DD",
              "prefix": "",
              "append": "-"
            },
            "content": {
              "type": "user",
              "command": "QuickAdd: Choose properties"
            }
          }
        ]
      }
    },
    "task": {
      "type": "macro",
      "name": "New Task",
      "macro": {
        "actions": [
          {
            "type": "createNote",
            "name": "Create task",
            "path": "wiki/tasks/inbox",
            "template": "templates/task.md",
            "openInNewPane": true,
            "fileName": {
              "type": "user",
              "command": "QuickAdd: Choose properties"
            },
            "content": {
              "type": "user",
              "command": "QuickAdd: Choose properties"
            }
          }
        ]
      }
    },
    "event": {
